# Copy to .env and adjust. On Fly, set these with `fly secrets set`.

# App connection: a login role that is a member of `wepunch_app`.
# It must NOT own the tables or have BYPASSRLS, so Row-Level Security applies.
DATABASE_URL=postgres://wepunch_app_login:app_password@localhost:54322/wepunch

# Owner connection: runs migrations and seeds. Never used by request handlers.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:54322/wepunch

REDIS_URL=redis://localhost:63799

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Root domain for tenant subdomains: joes-coffee.<ROOT_DOMAIN>
# Locally, *.localhost resolves to 127.0.0.1 in modern browsers.
ROOT_DOMAIN=localhost:3000

# Sentry. The DSN defaults to the wepunch project (src/lib/sentry-options.ts);
# set these per environment on Fly.
SENTRY_ENVIRONMENT=development
# SENTRY_DISABLED=1
# Build-time only, for source map upload (CI secret / Docker build arg). Never commit it.
# SENTRY_AUTH_TOKEN=
